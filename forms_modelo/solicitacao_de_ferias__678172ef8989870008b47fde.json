            {
              "className": "col-6",
              "resetOnHide": true,
              "key": "inicio_ferias",
              "type": "next-date",
              "templateOptions": {
                "label": "Início das férias",
                "focus": "false",
                "type": "text",
                "required": true
              }
            },
            {
              "className": "col-6",
              "resetOnHide": true,
              "key": "fim_ferias",
              "type": "next-date",
              "templateOptions": {
                "label": "Fim das férias",
                "focus": "false",
                "type": "text",
                "required": true
              }
            },
            {
              "key": "aviso_data",
              "resetOnHide": true,
              "type": "next-html",
              "templateOptions": {
                "textHtml": "<div class='flex flex-col mt-2  p-4 rounded bg-red-100 font-medium text-red-800'><div class='flex space-x-2 text-red-500 mb-2' ><div><svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5' viewBox='0 0 20 20'fill='currentColor'><path fill-rule='evenodd' d='M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z' clip-rule='evenodd'/></svg></div><div class=' text-red-800' >Atenção</div></div><div>A solicitação de férias deve ser realizada com, no mínimo, 10 dias de antecedência ao primeiro dia do período em que as férias serão usufruídas.</div></div><br>",
                "focus": "false",
                "required": false,
                "readonly": true
              },
              "expressionProperties": {
                "templateOptions|||required": "(() => { try { let data_selec = model.inicio_ferias; if (!data_selec) return false; let data_selec_format = new Date(data_selec); let data_hoje_format = new Date(); let timeDiff = data_selec_format - data_hoje_format; let diffDays = Math.ceil(timeDiff / (1000 * 3600 * 24)); return diffDays < 10; } catch (err) { return false; } })()"
              },
              "hideExpression": "!model.inicio_ferias || (() => { try { return !field.templateOptions.required; } catch (err) { return false; } })()"
            },
            {
              "key": "total_dias",
              "type": "next-input",
              "templateOptions": {
                "label": "Total de dias de férias",
                "placeholder": "Ex: 10",
                "focus": "false",
                "type": "number",
                "suffix": "dias",
                "readonly": true,
                "columns": "12",
                "required": false,
                "hidden": false
              },
              "expressionProperties": {
                "model|||total_dias": "(()=>{try{let data_selec_1=model.inicio_ferias;let data_selec_format_1=new Date(data_selec_1);let data_selec_2=model.fim_ferias;let data_selec_format_2=new Date(data_selec_2);let date1=new Date(data_selec_format_1);let date2=new Date(data_selec_format_2);let timeDiff=Math.abs(date2.getTime()-date1.getTime()+1);let diffDays=Math.ceil(timeDiff/(1000*3600*24));if(model.inicio_ferias&&model.fim_ferias){return diffDays}}catch(err){return err}})()"
              },
              "className": "col-12"
            }
          ],
          "templateOptions": {
            "title": "Dados da Solicitação",
