        "tab": null,
        "action": null
      },
      {
        "title": "02. Averiguação de dados e definição da necessidade de visita presencial.",
        "description": "Neste momento a coordenação de requisitos irá avaliar o processo para identificar e mencionar a necessidade ou não de uma visita presencial. Caso não seja necessário, o processo será encaminhado para a gerência de produção de sistema.",
        "sector": "req_demoad",
        "estimatedTime": 10,
        "timeUnit": 86400000,
        "reponseTimeLimit": 10,
        "startStepDate": "2023-10-26T18:20:26.766Z",
        "applicantActivitiesVisible": null,
        "activities": null,
        "automatic": [
          {
            "subscribe": [
              "process/update/activities"
            ],
            "execute": "({ resume, activities, signatures, documents, process }) => {\n    if (activities.visprecs.vispres === 'Não') {\n        sendTo({ groupId: 'gps_demoad' })\n        finishStep();\n    } else {\n        finishStep ();\n    }\n}"
          }
        ],
        "hideFinishedFeedback": "Não",
        "finishedInformation": "Etapa finalizada! O processo foi encaminhado para a Gerência de produção de sistemas",
        "tab": [],
        "action": []
      },
      {
        "title": "03. Análise de Complexidade",
        "description": "Nessa etapa o gerente de produção de sistema irá indicar qual a complexidade da solicitação.",
        "sector": "gps_demoad",
        "estimatedTime": 3,
        "timeUnit": 86400000,
        "reponseTimeLimit": null,
        "applicantActivitiesVisible": false,
        "activities": [],
        "automatic": [
          {
            "subscribe": [
              "process/update/activities"
            ],
            "execute": "({ resume, activities, signatures, documents, process }) => {\n    if (activities.analise_solicitacao.complexidade === 'Baixa complexidade') {\n        return [sendTo({ groupId: 'baixademoad_demoad' }), finishStep()];\n    } else if (activities.analise_solicitacao.complexidade === 'Média complexidade') {\n        return [sendTo({ groupId: 'cdmc_demoad' }), finishStep()];\n    } else if (activities.analise_solicitacao.complexidade === 'Alta complexidade') {\n        return [sendTo({ groupId: 'altaa_demoad' }), finishStep()];\n    }\n}"
          }
