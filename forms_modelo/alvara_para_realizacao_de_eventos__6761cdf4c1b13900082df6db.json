                "templateOptions|||readonly": "model.requerente == 'Usuário logado no sistema' ? true : false"
              }
            },
            {
              "key": "telefone_requerente",
              "type": "next-input",
              "templateOptions": {
                "label": "Telefone",
                "placeholder": "(00) 00000-0000",
                "required": true,
