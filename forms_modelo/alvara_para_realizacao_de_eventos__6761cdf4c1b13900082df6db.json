                "required": true
              },
              "expressionProperties": {
                "model|||cpfcnpj_requerente": "model.requerente == 'Usuário logado no sistema' ? (model.user_dados?.user?.user_metadata.cpf) : model.cpfcnpj_requerente",
                "templateOptions|||mask": "model.cpfcnpj_requerente?.length >= 12 ? '00.000.000/0000-00': '000.000.000-009' ",
                "templateOptions|||readonly": "model.requerente == 'Usuário logado no sistema' ? true : false"
              }
