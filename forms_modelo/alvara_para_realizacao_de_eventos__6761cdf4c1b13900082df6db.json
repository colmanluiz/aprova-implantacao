                "disabled": false,
                "hidden": false
              },
              "expressionProperties": {
                "model|||telefone_requerente": "model.telefone_requerente ? model.telefone_requerente : model.requerente == 'Usuário logado no sistema' ? model.user_dados?.user?.user_metadata.telefone : model.usuario_telefone",
                "templateOptions|||mask": "model.telefone_requerente?.length === 11 ? '(00) 00000-0000': '(00) 0000-00009'"
              },
              "hideExpression": "(()=>{try{return!field.templateOptions?.required}catch(err){return(err)}})()"
