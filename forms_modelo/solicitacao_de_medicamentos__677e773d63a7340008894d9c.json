                "required": true
              },
              "expressionProperties": {
                "model|||user": "model.requerente == 'Usuário logado no sistema' ? model.user_dados?.user?.user_metadata.name : model.user",
                "templateOptions|||readonly": "model.requerente == 'Usuário logado no sistema' ? true : false"
              }
            },
