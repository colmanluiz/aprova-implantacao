{
  "name": "aprova-implantacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Implantação assistida por IA: coleta e validação de regras de negócio de processos municipais sem reunião",
  "scripts": {
    "analyze": "tsx src/cli.ts analyze",
    "validate": "tsx src/cli.ts validate",
    "apply": "tsx src/cli.ts apply",
    "chat": "node --dns-result-order=ipv4first --env-file-if-exists=.env --import tsx src/channel/mock-chat.ts",
    "telegram": "node --dns-result-order=ipv4first --env-file-if-exists=.env --import tsx src/channel/telegram.ts",
    "agent": "node --env-file-if-exists=.env --import tsx",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "painel": "node --env-file-if-exists=.env --import tsx src/painel/server.ts",
    "painel:data": "tsx scripts/painel-data.ts",
    "typecheck": "tsc --noEmit",
    "docs": "tsx scripts/gerar-pipeline-md.ts",
    "gate": "node --env-file-if-exists=.env --import tsx scripts/gate.ts",
    "pipeline:offline": "tsx scripts/rodar-pipeline-offline.ts --sem-llm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
